{
  "name": "helping-hand-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Helping Hand - Monorepo with mobile app and voice AI server",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:app": "cd packages/helping-hand && npm run dev",
    "dev:server": "cd packages/helping-hand-server && npm run dev",
    "install:all": "npm install && npm run install:packages",
    "install:packages": "cd packages/helping-hand && npm install && cd ../helping-hand-server && npm install",
    "test:app": "cd packages/helping-hand && npm test",
    "test:server": "cd packages/helping-hand-server && npm test",
    "build:app": "cd packages/helping-hand && npm run build:web",
    "build:server": "cd packages/helping-hand-server && npm start",
    "deploy:server": "cd packages/helping-hand-server && railway up"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}