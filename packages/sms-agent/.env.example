# Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Clawslist backend
CLAWSLIST_API_URL=https://clawslist-server.railway.app
INTERNAL_API_SECRET=change_me_strong_random_secret

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (service role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Wallet encryption — must match across restarts
WALLET_ENCRYPTION_SECRET=change_me_32_plus_chars_random_secret

# URL this service is publicly reachable at (for Twilio signature validation)
WEBHOOK_BASE_URL=https://your-sms-agent.railway.app

# Server port
PORT=3100
NODE_ENV=production
