# Server Environment Variables

PORT=3001
NODE_ENV=development
SERVER_BASE_URL=https://your-server-domain.com

# Twilio (Voice + SMS)
TWILIO_ACCOUNT_SID=AC_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15551234567

# Vapi Voice AI
VAPI_API_KEY=your_vapi_key
VAPI_WEBHOOK_SECRET=your_webhook_secret
VAPI_ASSISTANT_ID=your_assistant_id

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# HelloSign (Dropbox Sign) E-Signature
HELLOSIGN_API_KEY=your_hellosign_api_key
HELLOSIGN_CLIENT_ID=your_app_client_id

# App Settings
APP_NAME="Helping Hand"
SUPPORT_PHONE=+1-800-XXX-XXXX
SUPPORT_EMAIL=support@helpinghand.app